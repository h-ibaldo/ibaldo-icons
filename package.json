{
	"name": "zicon",
	"version": "0.1.0",
	"description": "A comprehensive line-based icon library with 2,441+ icons, AI-powered naming, and React/Svelte packages",
	"type": "module",
	"keywords": [
		"icons",
		"icon-library",
		"svg-icons",
		"react-icons",
		"svelte-icons",
		"line-icons",
		"ui-icons",
		"icon-components"
	],
	"author": "Henrique Ibaldo",
	"license": "MIT",
	"homepage": "https://zicon.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/h-ibaldo/zicon.git"
	},
	"bugs": {
		"url": "https://github.com/h-ibaldo/zicon/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build:icons": "node scripts/build-icons.js",
		"build:icons:all": "node scripts/build-icons.js --all",
		"build:icons:test": "node scripts/build-icons-test.js 5",
		"build:icons:test:all": "node scripts/build-icons-test.js 5 --all",
		"test:ai-naming": "node scripts/test-ai-naming.js",
		"test:metadata": "node scripts/generate-test-metadata.js 10",
		"test:metadata:small": "node scripts/generate-test-metadata.js 5",
		"test:metadata:medium": "node scripts/generate-test-metadata.js 50",
		"generate:index": "node scripts/generate-icons-index.js",
		"generate:index:ai": "NAMING_STRATEGY=ai node scripts/generate-icons-index.js",
		"generate:index:algorithm": "NAMING_STRATEGY=algorithm GENERATE_METADATA=false node scripts/generate-icons-index.js",
		"generate:index:full": "NAMING_STRATEGY=ai GENERATE_METADATA=true node scripts/generate-icons-index.js",
		"process": "bash scripts/process-folder.sh",
		"prebuild": "npm run build:icons",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"release:patch": "node scripts/release-packages.js patch",
		"release:minor": "node scripts/release-packages.js minor",
		"release:major": "node scripts/release-packages.js major",
		"release:dry-run": "node scripts/release-packages.js patch --dry-run"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.72.1",
		"@sveltejs/adapter-vercel": "^5.2.2",
		"@sveltejs/kit": "^2.15.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"autoprefixer": "^10.4.20",
		"dotenv": "^17.2.3",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"sharp": "^0.34.5",
		"svelte": "^5.17.3",
		"tailwindcss": "^3.4.9",
		"vite": "^5.0.0"
	},
	"dependencies": {
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"zip-a-folder": "^1.1.4"
	}
}
