{
	"name": "ibaldo-icons",
	"version": "0.1.0",
	"description": "A comprehensive line-based icon library with 2,441+ icons, named from the drawings, and React/Svelte packages",
	"type": "module",
	"keywords": [
		"icons",
		"icon-library",
		"svg-icons",
		"react-icons",
		"svelte-icons",
		"line-icons",
		"ui-icons",
		"icon-components"
	],
	"author": "Henrique Ibaldo",
	"license": "MIT",
	"homepage": "https://icons.ibald.ooo",
	"repository": {
		"type": "git",
		"url": "https://github.com/h-ibaldo/primor-icons.git"
	},
	"bugs": {
		"url": "https://github.com/h-ibaldo/primor-icons/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build:icons": "node scripts/build-icons.js",
		"build:icons:all": "node scripts/build-icons.js --all",
		"generate:index": "node scripts/generate-icons-index.js",
		"audit:icons": "node scripts/audit-icons-index.js",
		"name:sheet": "node scripts/contact-sheet.js",
		"name:apply": "node scripts/apply-metadata.js",
		"process": "bash scripts/process-folder.sh",
		"prebuild": "npm run build:icons",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"release:patch": "node scripts/release-packages.js patch",
		"release:minor": "node scripts/release-packages.js minor",
		"release:major": "node scripts/release-packages.js major",
		"release:dry-run": "node scripts/release-packages.js patch --dry-run"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^5.2.2",
		"@sveltejs/kit": "^2.15.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"autoprefixer": "^10.4.20",
		"playwright": "^1.58.2",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"sharp": "^0.34.5",
		"svelte": "^5.17.3",
		"tailwindcss": "^3.4.9",
		"vite": "^5.0.0"
	},
	"dependencies": {
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"zip-a-folder": "^1.1.4"
	}
}
